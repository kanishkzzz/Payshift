# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Staff Authentication (JWT / Session secret)
AUTH_SECRET="your-32-character-secret-key-here"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Gateway & Messaging (Dev mode)
MOCK_GATEWAY_SECRET="mock_secret_key"
MOCK_SMS_GATEWAY_API_KEY="mock_sms_key"

# Cron Secret for automated jobs
CRON_SECRET="your-cron-secret-token"
