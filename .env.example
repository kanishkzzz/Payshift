# Database Connection (Neon PostgreSQL)
# Use the pooled host for DATABASE_URL and the direct host for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
INSTITUTE_NAME="Tracky"

# Used only by `npm run db:create-staff`; choose a unique, strong password.
STAFF_EMAIL=""
STAFF_PASSWORD=""
STAFF_NAME="Kanishk Negi"

# Optional reviewer OTP for one synthetic parent in an isolated demo database.
# In production the fixed code is accepted only for DEMO_PARENT_PHONE.
DEMO_PARENT_PHONE=""
DEMO_PARENT_OTP=""

# Vercel Blob (create a Blob store and set its read-write token in Vercel/local env)
BLOB_READ_WRITE_TOKEN=""

# Mock Gateway (Dev mode)
MOCK_GATEWAY_SECRET="mock_secret_key"
MOCK_PAYMENT_WEBHOOK_SECRET="mock_webhook_secret_key"
# Placeholder only: no SMS provider is integrated; development OTPs are shown in the UI/log.
MOCK_SMS_GATEWAY_API_KEY="mock_sms_key"

# Payment Gateway Driver ("mock" | "razorpay")
PAYMENT_GATEWAY="mock"
RAZORPAY_SETTLE_ON_VERIFY="false"

# Razorpay Credentials (Test Mode only - read from env vars, do not commit real secrets)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cron Secret for automated jobs
CRON_SECRET="your-cron-secret-token"

# Risk evaluation provider (only "mock" is currently implemented)
RISK_LLM_PROVIDER="mock"
