# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Staff Authentication (JWT / Session secret)
AUTH_SECRET="your-32-character-secret-key-here"

# App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Gateway (Dev mode)
MOCK_GATEWAY_SECRET="mock_secret_key"
MOCK_PAYMENT_WEBHOOK_SECRET="mock_webhook_secret_key"
# Placeholder only: no SMS provider is integrated; development OTPs are shown in the UI/log.
MOCK_SMS_GATEWAY_API_KEY="mock_sms_key"

# Payment Gateway Driver ("mock" | "razorpay")
PAYMENT_GATEWAY="mock"

# Razorpay Credentials (Test Mode only - read from env vars, do not commit real secrets)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Cron Secret for automated jobs
CRON_SECRET="your-cron-secret-token"
